#!/bin/bash

# Set the proper environment for GUI applications
export HOME="/home/fwaith"
export USER="fwaith"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

# Directory containing wallpapers
WALL_DIR="$HOME/Pictures/Wallpapers"

# Current directory (to cd back to)
CWD="$(pwd)"

cd "$WALL_DIR" || exit 1

# Handle spaces in filenames
IFS=$'\n'

# Grab the user-selected wallpaper
SELECTED_WALL=$(shopt -s nullglob; for a in *.jpg *.png *.webp; do echo -en "$a\0icon\x1f$a\n" ; done | rofi -config ~/.config/rofi/config-change-theme.rasi -dmenu)

# If not empty, pass to backend
if [ -n "$SELECTED_WALL" ]; then
    change-theme-backend "$SELECTED_WALL"
fi

# Go back original directory
cd "$CWD" || exit
